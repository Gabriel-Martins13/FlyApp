<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFly.FlyoutP"
             >
    <FlyoutPage.Flyout>
        <ContentPage Title="Valorant" BackgroundColor="Black">
            <StackLayout Spacing="10">

                <Label Text="Menu" FontSize="24" HorizontalOptions="Center" Margin="0,20,0,20" TextColor="White"/>

                <Button Text ="Gasolina/Etanol"
                        Clicked="gasetaClicked"
                        WidthRequest="200"/>

                <Button Text ="Autonomia Km/L"
                        Clicked="OnautonomiaClicked"
                        WidthRequest="200"/>

            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>
</FlyoutPage>