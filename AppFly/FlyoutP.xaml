<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFly.FlyoutP"
             FlyoutLayoutBehavior="Popover"
             >
    <FlyoutPage.Flyout>
        <ContentPage Title="Valorant" BackgroundColor="Black">
            <StackLayout Spacing="30">

                <Label Text="Menu" FontSize="24" HorizontalOptions="Center" Margin="0,20,0,20" TextColor="White"/>

                <Button Text ="Valorant"
                        Clicked="Valorant"
                        WidthRequest="200"/>

                <Button Text ="Autonomia Km/L"
                        Clicked="OnValorantClicked"
                        WidthRequest="200"/>

            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>
</FlyoutPage>