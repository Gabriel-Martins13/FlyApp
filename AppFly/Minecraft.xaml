<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFly.Minecraft"            
             BackgroundImageSource="waaa.jpg"
             >
    <VerticalStackLayout>
        <Image
            Margin="0,32,0,0"
            Source="minjen.jpg"
            HeightRequest="140"
                />
        <VerticalStackLayout
            BackgroundColor="#80000000"
            HeightRequest="200"
            >

            <Label 
            Text="Minecraft"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="50"
            TextColor="FloralWhite"
            FontFamily = "OpenSansSemibold"
            />
            <Label
            Text="Minecraft é um jogo eletrônico sandbox de sobrevivência de 2011 desenvolvido e publicado pela desenvolvedora sueca Mojang Studios. Originalmente criado por Markus (Notch) Persson usando a linguagem de programação Java, a primeira versão alfa pública foi lançada em 17 de maio de 2009."
            VerticalOptions="Center"
            HorizontalOptions="Center"
            TextColor="WhiteSmoke"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"
            FontFamily = "OpenSans"
    />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>